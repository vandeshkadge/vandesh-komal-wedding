+
+
+/* =========================================================
+   ZEPHYR — WEDDING TIMELINE BREEZE
+   Stitch breezeArrival applied to each complete timeline event.
+   ========================================================= */
+
+@keyframes breezeArrival {
+  0% {
+    transform: translate3d(-70px, 8px, 0) rotate(-3.5deg) scale(0.94);
+    opacity: 0;
+    filter: blur(5px);
+  }
+  55% {
+    transform: translate3d(8px, -2px, 0) rotate(0.8deg) scale(1.01);
+    opacity: 0.85;
+    filter: blur(0.5px);
+  }
+  80% {
+    transform: translate3d(-2px, 0.5px, 0) rotate(-0.3deg) scale(0.995);
+    opacity: 0.98;
+    filter: blur(0px);
+  }
+  100% {
+    transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
+    opacity: 1;
+    filter: blur(0px);
+  }
+}
+
+.timeline .zephyr-arrival-active {
+  opacity: 0;
+  animation: breezeArrival 1.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
+  animation-delay: var(--breeze-delay, 0s);
+  animation-play-state: paused;
+  will-change: transform, opacity, filter;
+  backface-visibility: hidden;
+}
+
+.timeline .section-inner.is-visible .zephyr-arrival-active {
+  animation-play-state: running;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .zephyr-arrival-active {
+    animation: none !important;
+    opacity: 1 !important;
+    transform: none !important;
+    filter: none !important;
+  }
+}
